{
  "name": "tsushima-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Ghost of Tsushima-inspired 3D Feudal Japan open-world explorer built with Vite, Vanilla JS and Three.js.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host",
    "download-assets": "node scripts/download-assets.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@img/sharp-wasm32": "^0.35.5",
    "vite": "^5.4.8"
  }
}
